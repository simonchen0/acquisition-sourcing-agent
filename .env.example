# Copy to .env in the repo root; the app loads it automatically. Never commit real keys.
# Shell environment variables override values here. Restart the app after editing.

# --- Proprietary companies (Apollo; paid plan with API access) ---
APOLLO_API_KEY=
# Actual USD cost of one credit on your plan; blank/0 disables Apollo requests.
APOLLO_CREDIT_COST_USD=
APOLLO_SEARCH_CREDITS=1
APOLLO_ENRICH_CREDITS=1
APOLLO_REVEAL_CREDITS=1
# Set true only after confirming your Apollo license permits storing / re-exporting data.
APOLLO_STORAGE_RIGHTS_CONFIRMED=false
APOLLO_EXPORT_RIGHTS_CONFIRMED=false
APOLLO_CALLS_PER_HOUR=600
APOLLO_MIN_INTERVAL_SECONDS=6

# --- Brokered listings (Brave Search) ---
BRAVE_SEARCH_API_KEY=
BRAVE_STORAGE_RIGHTS_CONFIRMED=false
BRAVE_EXPORT_RIGHTS_CONFIRMED=false
BRAVE_REQUEST_COST_USD=0.005

# --- Investment evaluation (OpenAI, optional) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60

# --- Local runtime (defaults shown) ---
# PORT=8000
# DATA_DIR=.data
# Optional: fixed Fernet key for uploaded documents; otherwise one is generated in DATA_DIR.
# DOCUMENT_ENCRYPTION_KEY=
