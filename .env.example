# Copy into .env; the application and Docker Compose read it. Never commit real credentials.
# DATABASE_URL=postgresql+psycopg://acquisition:YOUR_URL_SAFE_PASSWORD@db:5432/acquisition
POSTGRES_PASSWORD=CHANGE_ME
# DATA_DIR=/data  # Compose sets this for its containers.
COOKIE_SECURE=false  # Local HTTP only; set true for hosted HTTPS.
BRAVE_STORAGE_RIGHTS_CONFIRMED=false
BRAVE_EXPORT_RIGHTS_CONFIRMED=false
BRAVE_SEARCH_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Set a persistent Fernet key for production; see README. Keep it outside source control.
DOCUMENT_ENCRYPTION_KEY=
# Pricing is configurable and must match your current provider plan.
BRAVE_REQUEST_COST_USD=0.005
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60

# Apollo: verify prices and per-call credits against your paid plan before enabling.
APOLLO_API_KEY=
APOLLO_CREDIT_COST_USD=
APOLLO_SEARCH_CREDITS=1
APOLLO_ENRICH_CREDITS=1
APOLLO_REVEAL_CREDITS=1
APOLLO_STORAGE_RIGHTS_CONFIRMED=false
APOLLO_EXPORT_RIGHTS_CONFIRMED=false
APOLLO_CALLS_PER_HOUR=600
APOLLO_MIN_INTERVAL_SECONDS=6
# true for one-process development; Compose overrides this to false for its web service.
EMBEDDED_WORKER=true
