# Copy to .env in the repo root; the app loads it automatically. Never commit real keys.
# Shell environment variables override values here.

# --- Discovery (Brave Search) ---
BRAVE_SEARCH_API_KEY=
# Set true only after confirming your Brave plan permits storing / re-exporting results.
BRAVE_STORAGE_RIGHTS_CONFIRMED=false
BRAVE_EXPORT_RIGHTS_CONFIRMED=false
BRAVE_REQUEST_COST_USD=0.005

# --- Investment evaluation (OpenAI, optional) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60

# --- Apollo (planned; see docs/plans/ai-sourcing-pipeline.md) ---
APOLLO_API_KEY=
APOLLO_CREDIT_COST_USD=

# --- Local runtime (defaults shown) ---
# PORT=8000
# DATA_DIR=.data
# Optional: fixed Fernet key for uploaded documents; otherwise one is generated in DATA_DIR.
# DOCUMENT_ENCRYPTION_KEY=
